# ElevenLabs (optional — app runs in deterministic demo mode without these)
# Key scopes needed: ElevenAgents (Read/Write), Text to Speech (Access), Speech to Text (Access), Voices (Read/Write).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID_INTERVIEWER=
ELEVENLABS_AGENT_ID_TUTOR=
ELEVENLABS_VOICE_ID=

# LLM for debrief/question generation (optional) — "anthropic" or "openai"
LLM_PROVIDER=
LLM_API_KEY=
# LLM_MODEL=

# Vision provider for screen-frame understanding (optional) — "anthropic" or "openai"
VISION_PROVIDER=
VISION_API_KEY=
# VISION_MODEL=

DATABASE_URL=sqlite:///./umbra.db

# Demo access code for the Trial reviewer console. Change it for anything beyond a demo.
# REVIEWER_ACCESS_CODE=umbra-review-demo
